# Both Railway server and local client must use the same long random token.
AUTH_TOKEN=replace-with-at-least-24-random-characters

# Local client only
REMOTE_SERVER_URL=wss://your-service.up.railway.app
LOCAL_TARGET=http://127.0.0.1:3000

# Optional: require public callers to send X-Tunnel-Token.
# PUBLIC_AUTH_TOKEN=another-long-random-token

# Optional limits (defaults shown)
MAX_BODY_BYTES=10485760
REQUEST_TIMEOUT_MS=30000
LOCAL_REQUEST_TIMEOUT_MS=30000
